# ── Swapno Puron Hobe — Frontend environment ──
# NEXT_PUBLIC_* vars are baked into the client bundle AT BUILD TIME,
# so this must be set BEFORE `next build` (in Coolify: mark it as a build variable).

# Public URL of the backend API (note the /api suffix)
NEXT_PUBLIC_API_URL=https://api.shopnopuronhobe.com/api

# Local development uses:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
